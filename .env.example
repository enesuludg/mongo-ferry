# Source: MongoDB 3.6 cluster
SOURCE_URI=mongodb://user:pass@source-host:27017/?authSource=admin
SOURCE_DB=app

# Target: MongoDB 7.x cluster
TARGET_URI=mongodb://user:pass@target-host:27017/?authSource=admin
TARGET_DB=app

# Optional defaults (CLI flags override these)
COLLECTION=users
# TARGET_COLLECTION=users_v7
# Optional. Only used with --since / --dateField; does not filter on its own.
# SINCE=30d
BATCH_SIZE=1000
CONCURRENCY=16
SOURCE_POOL_SIZE=16
TARGET_POOL_SIZE=64
ON_CONFLICT=replace
CHECKPOINT_FILE=.migrate-checkpoint.json
